# Copy to .env and adjust. Nothing here is a real credential.
# A read-only token is sufficient. v0.1 never writes to GitHub.
GITHUB_TOKEN=
PR_SHEPHERD_DB=./shepherd.db
PR_SHEPHERD_TRANSPORT=urllib          # urllib | gh
PR_SHEPHERD_API_URL=https://api.github.com
PR_SHEPHERD_SELF_LOGINS=              # comma-separated logins of the account that authored the PR (ignored as feedback)
PR_SHEPHERD_TRUSTED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
PR_SHEPHERD_MAX_REVISION_ROUNDS=3
PR_SHEPHERD_MAX_CI_REPAIR_ROUNDS=3
PR_SHEPHERD_MAX_CONSECUTIVE_UNKNOWN_FAILURES=3
PR_SHEPHERD_ALLOW_FACTUAL_REPLIES=0
PR_SHEPHERD_PREFERRED_WORKER=codex
PR_SHEPHERD_FALLBACK_WORKER=claude
PR_SHEPHERD_WEBHOOK_SECRET=
